# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (the AI evaluation layer)
ANTHROPIC_API_KEY=

# AI spend controls — two knobs, not one. See docs/operations/cost-controls.md.
# Alert: on where set, changes nothing, tells you. Ceiling: off by default,
# refuses work. Set these per environment and confirm them against the running
# deployment, not against this file (docs/engineering/verification.md §3).
ATLAS_AI_DAILY_ALERT_USD=
ATLAS_AI_DAILY_CEILING_USD=

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
